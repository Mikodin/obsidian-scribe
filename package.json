{
	"name": "obsidian-scribe-plugin",
	"version": "2.3.2",
	"description": "An Obsidian plugin for recording voice notes, transcribing the audio, and summarizing the text - All in one",
	"main": "build/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build:prod": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"update-all-deps": "npm outdated | awk 'NR>1 {print $1\"@\"$4}' | xargs npm install",
		"format:check": "biome format ./src",
		"format:write": "biome format --write ./src"
	},
	"keywords": [],
	"author": "Mike Alicea",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.1.3",
		"builtin-modules": "^5.3.0",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.1",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@langchain/core": "^1.2.2",
		"@langchain/openai": "^1.5.5",
		"assemblyai": "^4.35.4",
		"langchain": "^1.5.3",
		"mini-debounce": "^1.0.8",
		"openai": "^6.46.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"standardized-audio-context": "^25.3.77",
		"zod": "^4.4.3"
	}
}
